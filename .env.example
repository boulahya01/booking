# UNEEM V2 browser configuration
# Required for development and production. Configure real values only in ignored
# local environment files or the deployment provider.

VITE_SUPABASE_URL=https://projectreference.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy browser-safe anon key is supported only as a compatibility fallback.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional fallback origin for non-browser auth-link construction.
# Browser signup/recovery uses the current origin.
VITE_APP_URL=https://www.uneem.site

# Guest Help is hosted by the Supabase guest-support Edge Function; Vercel does
# not need SUPABASE_SERVICE_ROLE_KEY or an IP-hash secret.
