# UNEEM V2 browser configuration
# Use the fresh V2 Supabase project only.

# Project API URL, for example https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Preferred modern browser-safe Supabase publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy browser-safe anon key is supported only as a compatibility fallback.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional fallback origin for non-browser auth-link construction.
# Browser signup/recovery uses the current origin so Vercel previews remain valid.
VITE_APP_URL=https://uneem.site
