# UNEEM V2 Supabase browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy fallback only:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
VITE_APP_URL=http://localhost:5173

# Server-only guest Help creation gate. Never expose these through VITE_* vars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Generate at least 32 random bytes; used only to HMAC client IPs before DB storage.
SUPPORT_IP_HASH_SECRET=replace-with-a-long-random-secret
