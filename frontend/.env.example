# UNEEM V2 browser configuration
# Production is pinned in supabaseClient.ts to the selected free Supabase project.
# These variables are optional development overrides only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy browser-safe fallback only:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
VITE_APP_URL=http://localhost:5173

# Guest Help runs in Supabase Edge Functions. No service-role key belongs in Vercel.
