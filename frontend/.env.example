# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
# Prefer the modern publishable key. Legacy anon remains supported by the client as a fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=legacy-anon-key-only-if-needed

# Canonical app origin used in confirmation and password-recovery redirects.
VITE_APP_URL=http://localhost:5173
